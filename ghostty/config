font-family = "ZedMono Nerd Font Mono"
font-size = 16

theme = dark:Rose Pine, light: Rose Pine Dawn

background-opacity = 0.85
background-blur = 20

window-theme = ghostty
window-padding-color = extend
window-vsync = false
# Fullscreen by default
maximize = true

keybind = ctrl+shift+page_up=scroll_page_fractional:-0.5
keybind = ctrl+shift+page_down=scroll_page_fractional:0.5
keybind = ctrl+alt+k=scroll_page_fractional:-0.5
keybind = ctrl+alt+j=scroll_page_fractional:0.5

keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+l=goto_split:right

keybind = ctrl+alt+[=resize_split:left,50
keybind = ctrl+alt+]=resize_split:right,50
keybind = ctrl+alt+shift+[=resize_split:left,10
keybind = ctrl+alt+shift+]=resize_split:right,10
keybind = ctrl+alt+\=toggle_split_zoom
