# Easy source .bashrc alias
alias sc='source ~/.bashrc'

# Easy edit nvim config
alias nved='nvim ~/.config/nvim'

# alias ssh='kitten ssh '

alias l1='ls -a1'
alias ..='cd ..'
alias ...='cd ../..'

alias zed='VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json zed'

alias zcc="zig cc"

# Caveman Claude
alias cvcl="caveman claude"
